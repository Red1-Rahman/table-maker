{
  "name": "table-maker",
  "private": true,
  "version": "1.0.0",
  "description": "Canvas-first table creation and data manipulation environment (web + desktop).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src ./tests",
    "format": "biome format --write ./src ./tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=firefox --project=webkit",
    "test:e2e:ci": "playwright test --project=firefox --project=webkit",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:all": "playwright test --project=firefox --project=webkit --project=chromium",
    "test:e2e:install": "playwright install firefox webkit",
    "check:contracts": "tsx scripts/check-contracts.ts",
    "gen:templates": "tsx scripts/generate-templates.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "dompurify": "^3.2.0",
    "fflate": "^0.8.2",
    "immer": "^10.1.0",
    "jspdf": "^4.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.4"
  }
}
